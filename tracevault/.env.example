# TraceVault configuration. Copy to .env for local development; set these as
# managed secrets in your hosting provider for staging/production.
# Never commit real values.

# --- API ---
NODE_ENV=development                 # development | test | production
PORT=4000
# PostgreSQL connection (Supabase: Project Settings → Database → connection string, use sslmode=require)
DATABASE_URL=postgres://tracevault:tracevault@localhost:5432/tracevault
# Public URL of the API (used in signed upload/download links)
PUBLIC_API_URL=http://localhost:4000
# Dashboard origin (CORS + links in emails)
WEB_ORIGIN=http://localhost:3000

# 32-byte keys, base64. Generate with: openssl rand -base64 32
# Required in production. In development they are generated into var/dev-keys.json.
TV_DATA_KEY=                          # AES-256-GCM key for encrypting MFA secrets and stored recordings
TV_URL_SIGNING_KEY=                   # HMAC key for short-lived storage URLs

# Email: outbox (development only, emails visible at /dev/outbox) | resend
MAIL_PROVIDER=outbox
MAIL_FROM="TraceVault <no-reply@your-domain>"
RESEND_API_KEY=                       # required when MAIL_PROVIDER=resend

# Local data directory (dev keys, local encrypted object storage)
TV_VAR_DIR=./var
STORAGE_DIR=                          # defaults to $TV_VAR_DIR/object-storage

SESSION_TTL_HOURS=168
BACKGROUND_JOBS=true                  # hourly retention purge
DEV_OUTBOX=true                       # ignored in production
BILLING_SELF_SERVE=false              # plan switching without payment; forced on outside production

# --- Web dashboard ---
API_URL=http://localhost:4000         # where the Next.js /api proxy forwards requests (build-time)

# --- Simulator ---
TRACEVAULT_API=http://localhost:4000
