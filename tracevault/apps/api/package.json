{
  "name": "@tracevault/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json && node --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "db:migrate": "tsc -p tsconfig.build.json && node dist/db/migrate-cli.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@tracevault/api-contracts": "workspace:*",
    "@tracevault/event-schema": "workspace:*",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "roots": [
      "<rootDir>/../../tests/unit",
      "<rootDir>/../../tests/integration",
      "<rootDir>/../../tests/security"
    ],
    "testTimeout": 30000,
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules"
    ],
    "moduleNameMapper": {
      "^@tracevault/event-schema$": "<rootDir>/../../packages/event-schema/src",
      "^@tracevault/api-contracts$": "<rootDir>/../../packages/api-contracts/src"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../../tests/tsconfig.json"
        }
      ]
    }
  }
}
