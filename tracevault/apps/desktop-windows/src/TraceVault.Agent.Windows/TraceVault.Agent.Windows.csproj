<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows agent (console). Targets net8.0-windows without WinForms so it can be
    compiled on any OS with EnableWindowsTargeting; it runs only on Windows.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>tracevault-agent</AssemblyName>
    <RootNamespace>TraceVault.Agent.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TraceVault.Agent.Core\TraceVault.Agent.Core.csproj" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
